# Copy to .env and fill in. .env is gitignored — keep it that way.
#
#   cp .env.example .env
#
# ---------------------------------------------------------------------------
# THE ENCRYPTION KEY
# ---------------------------------------------------------------------------
# n8n encrypts every stored credential (API keys, SMTP passwords, OAuth
# tokens) with this key. It is NOT stored in the database.
#
#   >>> IF YOU LOSE THIS KEY, EVERY SAVED CREDENTIAL IS PERMANENTLY DEAD. <<<
#   >>> A database restore WILL NOT bring them back. You will have to      <<<
#   >>> re-enter every credential by hand, from the original sources.      <<<
#
# Generate one, once, before first boot:
#
#   openssl rand -base64 32
#
# Then put a copy somewhere that is NOT this server and NOT this repo:
# a password manager entry, or a printed page in a drawer. Backups of the
# server are not enough — if the box dies you need the key to read them.
#
# Changing this value later does not re-encrypt anything. n8n will simply
# fail to decrypt existing credentials. Set it once and leave it alone.
N8N_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Public address
# ---------------------------------------------------------------------------
# The HTTPS subdomain your reverse proxy serves. No scheme, no trailing slash.
# This drives WEBHOOK_URL and N8N_EDITOR_BASE_URL in docker-compose.yml, so
# external services calling your webhooks hit the right host.
N8N_HOST=n8n.example.com

# Loopback port the proxy forwards to. Only change if 5678 is taken.
N8N_BIND_PORT=5678

# How many reverse proxies sit in front of n8n. 1 for a single nginx/Caddy.
N8N_PROXY_HOPS=1

# ---------------------------------------------------------------------------
# Version pin
# ---------------------------------------------------------------------------
# Always an explicit version. Never `latest`, `stable` or `next` — an
# unattended restart would then silently jump versions and run DB migrations
# you did not ask for. Bump this with scripts/update.sh, not by hand.
#
# Find the current stable tag:
#   curl -s https://hub.docker.com/v2/repositories/n8nio/n8n/tags/stable | \
#     grep -o '"digest":"[^"]*"'
# then match that digest against the numbered tags. (Docker's `latest` tracks
# the stable channel, which lags the newest published number by a release or
# two — that lag is deliberate, and you want it.)
N8N_IMAGE_TAG=2.32.7

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# Used for cron/schedule triggers and log timestamps. IANA name.
GENERIC_TIMEZONE=Etc/UTC

# Execution history retention, in hours. 336 = 14 days, matching the backup
# window. This is what keeps SQLite from growing without bound.
EXECUTIONS_DATA_MAX_AGE=336
EXECUTIONS_DATA_PRUNE_MAX_COUNT=10000

# info | warn | error | debug
N8N_LOG_LEVEL=info

# Docker volume holding /home/node/.n8n. Backup and restore scripts use this.
N8N_VOLUME_NAME=n8n_data

# ---------------------------------------------------------------------------
# Backups
# ---------------------------------------------------------------------------
# Daily snapshots to keep under backups/. 14 days.
BACKUP_RETENTION_DAYS=14

# Export credentials in PLAINTEXT as well as encrypted (0 = off, 1 = on).
#
# Off by default. When off, the credential export is encrypted with
# N8N_ENCRYPTION_KEY — safe to store, but only restorable if you still have
# the key. When on, backups/<date>/credentials.decrypted.json contains every
# API key you own in clear text; anyone who reads that directory owns your
# accounts. Only turn this on if the backup directory is itself encrypted.
BACKUP_DECRYPT_CREDENTIALS=0
